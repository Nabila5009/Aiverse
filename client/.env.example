# Local development backend URL. Vite loads this from client/.env.
# The API client uses this only in development when no value is configured.
VITE_API_BASE_URL=http://localhost:5001/api

# For Vercel, configure VITE_API_BASE_URL in Project Settings > Environment
# Variables and redeploy. Example:
# VITE_API_BASE_URL=https://aiverse-uoh5.onrender.com/api
